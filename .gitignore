# Entorno virtual
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# PyInstaller
/build/
dist/
# ContApp.spec SE VERSIONA: define como se compila la app y lo usa el workflow.
# Otros .spec que generes localmente para probar (ej: Test.spec) si quedan ignorados
# con un gitignore local o no se commitean.
!ContApp.spec

# Resultados (salidas, no se versionan)
resultados/
data/backups/

# Bitácora (logs)
log/bitacora.log

# Preferencias locales del usuario (tema, modo_prueba, etc.)
data/usuario.json
data/settings.json

# IDEs
.vscode/
.idea/
*.swp
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Archivos temporales
*.tmp
*.bak
*.log